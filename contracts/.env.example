# Deploy once on BSC testnet — never commit secrets
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOY_PRIVATE_KEY_HERE

# Optional: multisig or cold wallet receives Ownable (recommended)
ESCROW_OWNER_ADDRESS=0xYOUR_MULTISIG_OR_OPERATOR_ADDRESS

# Contract verification (Etherscan API v2 — required for BSC testnet after explorer deprecation)
# Create at https://etherscan.io/apis (unified key; supports chainId 97 for BscScan testnet).
ETHERSCAN_API_KEY=
# Optional alias if you only set this name locally
BSCSCAN_API_KEY=

# After deploy — same owner as constructor
VERIFY_CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS

BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
