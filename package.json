{
  "name": "zerokey-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch -p tsconfig.build.json --preserveWatchOutput",
    "lint": "eslint \"{src,test}/**/*.ts\" --no-error-on-unmatched-pattern",
    "format": "prettier --check \"**/*.{ts,md,json,yml,yaml,prisma}\"",
    "format:write": "prettier --write \"**/*.{ts,md,json,yml,yaml,prisma}\"",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:integration": "jest --runInBand --testNamePattern='@integration'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "contracts:compile": "pnpm --filter @zerokey-wallet/contracts compile",
    "contracts:test": "pnpm --filter @zerokey-wallet/contracts test",
    "contracts:deploy:bsc-testnet": "pnpm --filter @zerokey-wallet/contracts deploy:bsc-testnet",
    "contracts:deploy:merkle:bsc-testnet": "pnpm --filter @zerokey-wallet/contracts deploy:merkle:bsc-testnet",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,md,json,yml,yaml,prisma}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "grammy": "^1.42.0",
    "joi": "^18.1.2",
    "nestjs-pino": "^4.6.1",
    "permissionless": "^0.3.5",
    "pg": "^8.20.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
